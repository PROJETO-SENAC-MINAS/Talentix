# Copie com configure_dev.py; nenhum segredo real deve ser versionado.
APP_ENV=development
LOG_LEVEL=INFO
API_DOCS_ENABLED=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=talentix
DB_USER=talentix_app
DB_PASSWORD=

FRONTEND_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
FRONTEND_RESET_URL=http://127.0.0.1:5500/html/login.html
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Accept,X-CSRF-Token,X-Request-ID
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Gere uma chave NOVA e exclusiva com secrets.token_hex(32).
SECRET_KEY=
SESSION_COOKIE_NAME=talentix_session
CSRF_COOKIE_NAME=talentix_csrf
SESSION_MAX_AGE_SECONDS=3600
SESSION_COOKIE_SAMESITE=lax
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=10
# Em produção mantenha true e use HTTPS. O configurador usa false apenas localmente.
SESSION_COOKIE_SECURE=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_AUTH_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_SIZE_MB=12
EMAIL_CONFIRMATION_REQUIRED=false

IA_WORKER_TOKEN=
PAYMENT_WEBHOOK_TOKEN=

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@talentix.com
