# Copie com configure_dev.py; nenhum segredo real deve ser versionado.
APP_ENV=development
LOG_LEVEL=INFO
API_DOCS_ENABLED=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=talentix
DB_USER=talentix_app
DB_PASSWORD=

FRONTEND_ORIGIN=http://127.0.0.1:5500
FRONTEND_RESET_URL=http://127.0.0.1:5500/html/login.html
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Gere uma chave NOVA e exclusiva com secrets.token_hex(32).
SECRET_KEY=
SESSION_COOKIE_NAME=talentix_session
SESSION_MAX_AGE_SECONDS=86400
# Em produção mantenha true e use HTTPS. O configurador usa false apenas localmente.
SESSION_COOKIE_SECURE=true

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
EMAIL_CONFIRMATION_REQUIRED=false

IA_WORKER_TOKEN=
PAYMENT_WEBHOOK_TOKEN=

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@talentix.com
